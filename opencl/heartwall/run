#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

rm -f "${SCRIPT_DIR}/result.txt"

"${SCRIPT_DIR}/heartwall.out" \
  -n 1 \
  -f "${SCRIPT_DIR}/../../data/heartwall/test.avi" \
  -i "${SCRIPT_DIR}/../../data/heartwall/input.txt" \
  -p 0 \
  -d 0

python3 "${SCRIPT_DIR}/validate_result.py" \
  --reference "${SCRIPT_DIR}/nvidia-result-n1.txt" \
  --output "${SCRIPT_DIR}/result.txt"
